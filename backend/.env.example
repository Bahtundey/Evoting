# Backend port (5050 — macOS AirPlay Receiver occupies port 5000 by default)
PORT=5050

# MongoDB connection string (local or Atlas). Never commit a real one.
MONGO_URI=

# Secret used to sign JSON Web Tokens (any long random string)
JWT_SECRET=

# Frontend origin(s) allowed to call this API (CORS).
# Local dev: http://localhost:5173 — Production (Vercel): https://frontend-tuta.vercel.app
CLIENT_URL=https://frontend-tuta.vercel.app

# Initial administrator account (used by `npm run create-admin`)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
